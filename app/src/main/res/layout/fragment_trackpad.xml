<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.gesturemouse.TrackpadSurface
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- opens the phone's keyboard; what's typed goes to the computer.
             Sits over the pad's corner, where it costs the least room to drag
             in; touches on it don't reach the pad underneath. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyboard"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="⌨"
            android:textSize="20sp"
            android:contentDescription="Keyboard" />
    </FrameLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:textSize="11sp"
        android:textColor="@color/dim"
        android:text="Drag to move · tap to click · two fingers to scroll · two-finger tap right-clicks · double-tap-and-hold to drag" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeft"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:text="Left"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMiddle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:text="Mid"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRight"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="52dp"
            android:text="Right"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- invisible target for the phone keyboard; see KeyboardInput -->
    <com.gesturemouse.KeyboardInput
        android:id="@+id/keyboardInput"
        android:layout_width="1dp"
        android:layout_height="1dp" />
</LinearLayout>

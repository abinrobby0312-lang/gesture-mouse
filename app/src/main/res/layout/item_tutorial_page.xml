<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="28dp">

    <!-- the brand logo, first page only -->
    <ImageView
        android:id="@+id/pageLogo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:adjustViewBounds="true"
        android:contentDescription="Gesture Mouse"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_full"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pageStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:letterSpacing="0.18"
        android:textAllCaps="true"
        android:textColor="?attr/brandAccent"
        tools:ignore="UnusedAttribute"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/paper" />

    <TextView
        android:id="@+id/pageBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingMultiplier="1.35"
        android:textSize="14sp"
        android:textColor="@color/dim" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GestureMouse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- accent: overridden by the chosen ThemeOverlay.GestureMouse.Accent.* -->
        <item name="brandAccent">@color/accent_magenta</item>
        <item name="stateWaiting">@color/fire</item>
        <item name="colorPrimary">@color/accent_magenta</item>
        <item name="colorOnPrimary">@color/on_accent_magenta</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorTertiary">@color/ok</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:textColor">@color/paper</item>
        <item name="tabIndicatorColor">@color/accent_magenta</item>
        <!-- dark bar icons on the light theme, light ones on the dark -->
        <!-- the app picks its own light/dark palette; Android's automatic
             conversion would repaint it, as it did the walkthrough -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>

    <!--
        Fullscreen window for the tutorial dialog.

        A full theme, inheriting the app's. As a bare overlay it inherited the
        activity's theme instead, and the walkthrough came out on a lighter
        grey than the app. It must stay Material-based either way: without
        those attributes MaterialButton and TabLayout throw at inflation,
        crashing the walkthrough on first launch — the very first thing a new
        user sees. The chosen accent is applied to the dialog in code
        (TutorialDialog), since a full theme resets it to the default.
    -->
    <style name="Theme.GestureMouse.Fullscreen" parent="Theme.GestureMouse">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/ink</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Page indicator for the tutorial: brand magenta on the current page, dim elsewhere.

    Each state is a layer-list with a gravity-centred, explicitly sized item
    rather than a bare <shape>. TabLayout stretches a tab's background to fill
    the tab, which turns a plain oval into a tall squashed ellipse; centring a
    fixed-size layer inside it keeps the dot round whatever the tab measures.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="center" android:width="8dp" android:height="8dp">
                <shape android:shape="oval">
                    <solid android:color="?attr/brandAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="center" android:width="8dp" android:height="8dp">
                <shape android:shape="oval">
                    <solid android:color="@color/line" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

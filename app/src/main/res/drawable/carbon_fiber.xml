<?xml version="1.0" encoding="utf-8"?>
<!--
    Tiled carbon-fibre weave used as the app background.

    The tile lives in drawable-nodpi so Android doesn't rescale it per density —
    a resampled weave turns into visible banding, and the pattern only reads
    correctly at its authored pixel size.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/carbon_tile"
    android:tileMode="repeat"
    android:dither="true" />

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Legacy Bluetooth permissions, superseded on Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12+ runtime Bluetooth permissions. CONNECT drives the HID
         profile; ADVERTISE lets the phone become discoverable so the computer
         can find it in its Bluetooth settings. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Internet, for one thing: sending a bug report the user chose to send
        (BugReport.kt — the only file allowed to touch the network; a unit test
        enforces it). Versions before 1.9 had no internet permission at all.

        Having the permission makes the next point matter. MediaPipe (hand
        tracking) bundles Google's datatransport library to upload its own
        usage statistics, and with INTERNET granted it would. It is stopped by
        unregistering its upload backend, below: with no backend registered the
        library discards its events on the phone instead of sending them. Don't
        remove that entry. To check a built APK, dump its manifest with aapt2
        (the xmltree command, on AndroidManifest.xml) and search the output for
        "Cct": it must find nothing.

        ACCESS_NETWORK_STATE comes from the same library; its job scheduler
        throws without it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.GestureMouse">

        <!-- see the INTERNET note above: unregister MediaPipe's telemetry upload; keep this -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <!-- fullUser, not fullSensor: it follows the system auto-rotate toggle
             instead of overriding it, so locking rotation still works.

             configChanges matters more than it looks. Without it a rotation
             recreates the activity, and onDestroy stops the HID service — so
             every turn of the phone would drop the Bluetooth connection and
             need a reconnect. Handling the change ourselves keeps the mouse
             alive across rotation. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
